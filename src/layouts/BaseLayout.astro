---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import MobileNavbar from "../components/MobileNavbar.astro";
import Footer from "../components/Footer.astro";
import ParticlesBackground from "../components/ParticlesBackground.astro";
const { title = "AI@UCF" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bungee&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bungee&family=Inria+Sans:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="relative bg-black text-white overflow-w-hidden">
    <ParticlesBackground />
    <MobileNavbar />

    <div class="relative z-10">
      <Navbar />

      <slot />

      <!-- <Footer /> -->
    </div>
  </body>
</html>
