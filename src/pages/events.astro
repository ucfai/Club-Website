---
import BaseLayout from "../layouts/BaseLayout.astro";
import EventCard from "../components/EventCard.tsx";
import events from "../data/events.json";

const nextEvent = events[0];
---

<BaseLayout title="Events">
	<section class="min-h-[70vh] bg-[#0b1020] px-4 py-10 md:px-8 md:py-14">
		<div class="mx-auto flex w-full max-w-6xl flex-col items-center gap-8">
			<h1 class="text-center text-3xl font-bold text-white">AI@UCF Events Page</h1>
			{
				nextEvent ? (
					<EventCard event={nextEvent} client:load />
				) : (
					<p class="text-white/80">No upcoming events yet.</p>
				)
			}
		</div>
	</section>
</BaseLayout>
