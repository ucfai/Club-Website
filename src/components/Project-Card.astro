---
const {title, description, link, github_link} = Astro.props;
---

<div class="flex justify-center w-[500px] border-1 border-white rounded-3xl backdrop-blur-md bg-[rgba(128,128,128,0.2)]">
    <div class="flex flex-col gap-y-4 my-6 mx-12">
        <p class="text-center text-2xl text-white font-bold">
            {title}
        </p>

        <p class="mb-4 text-center text-white">
            {description}
        </p>

        <div class="flex flex-row gap-x-8 mx-auto mb-8">
            <a href={link} target="_blank">
                <img src="../../public/link-icon.png" class="w-12 rounded-4xl object-none">
            </a>

            <a href={github_link} target="_blank">
                <img src="../../public/github-icon.png" class="w-12">
            </a>
        </div>
    </div>
</div>