---

---

<div class="particles-wrapper fixed inset-0 -z-10">
  <div id="tsparticles" class="absolute inset-0"></div>
  <!-- <div class="absolute inset-0 backdrop-blur-[2px]"></div> -->
</div>

<script>
  import { tsParticles } from "@tsparticles/engine";
  import type { Container } from "@tsparticles/engine";
  import { loadSlim } from "@tsparticles/slim";
  import config from "../styles/particles-config";

  let particleContainer: Container | undefined;
  let particlesPaused = false;

  const setParticlesInteractivity = (isInteractive: boolean) => {
    if (!particleContainer) return;

    particleContainer.options.interactivity.events.onHover.enable =
      isInteractive;
    particleContainer.actualOptions.interactivity.events.onHover.enable =
      isInteractive;
    particleContainer.options.interactivity.events.onClick.enable =
      isInteractive;
    particleContainer.actualOptions.interactivity.events.onClick.enable =
      isInteractive;
  };

  const pauseParticles = () => {
    if (particlesPaused) return;
    particlesPaused = true;
    setParticlesInteractivity(false);
  };

  const resumeParticles = () => {
    if (!particlesPaused) return;
    particlesPaused = false;
    setParticlesInteractivity(true);
  };

  (window as any).resumeParticles = resumeParticles;

  window.addEventListener("DOMContentLoaded", async () => {
    await loadSlim(tsParticles);
    particleContainer = await tsParticles.load({
      id: "tsparticles",
      options: config,
    });

    document.addEventListener("mouseover", (e) => {
      const target = e.target as HTMLElement;

      if (target.closest(".no-particles")) {
        pauseParticles();
      }
    });

    document.addEventListener("mouseout", (e) => {
      const target = e.target as HTMLElement;

      if (!target.closest(".no-particles")) return;

      const next = (e.relatedTarget as HTMLElement | null)?.closest?.(
        ".no-particles",
      );

      if (!next) {
        resumeParticles();
      }
    });
  });
</script>
