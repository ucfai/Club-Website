---
import { Icon } from "astro-icon/components";

const currentPath = Astro.url.pathname;

let currentPage;

if (currentPath === "/events") {
  currentPage = "Events";
} else if (currentPath === "/projects") {
  currentPage = "Projects";
} else if (currentPath === "/about") {
  currentPage = "About";
} else {
  currentPage = "Home";
}
---

<nav
  class={`relative py-5 pl-7 pr-5 hidden 0_5xl:flex gap-4 ${currentPage === "Home" ? "justify-end" : "justify-between"} bg-linear-to-b from-black from-0% via-black via-65% to-transparent to-100%`}
>
  {
    currentPage !== "Home" && (
      <div class="no-particles flex items-center gap-3.5">
        <a href="/">
          <img
            src="/favicon.svg"
            alt="AI@UCF Logo"
            class="w-10 h-10 inline-block"
          />
        </a>
        <h1 class="text-[26px] font-bungee tracking-wider">
          <>
            <span class="text-white">AI</span><!--
        --><span class="text-[#F8D03F]">@UCF</span>
          </>
        </h1>
      </div>
    )
  }
  <div
    class="py-2 px-13 absolute left-1/2 transform -translate-x-1/2 no-particles flex items-center justify-center rounded-3xl gap-10 bg-[rgba(255,255,255,0.15)] border-[rgba(255,255,255,0.2)] border-[0.5px] font-inria-sans"
  >
    <a
      href="/about"
      class={currentPage === "About" ? "text-[#F8D03F]" : "text-white"}>About</a
    >
    <a
      href="/events"
      class={currentPage === "Events" ? "text-[#F8D03F]" : "text-white"}
      >Events</a
    >
    <a
      href="/projects"
      class={currentPage === "Projects" ? "text-[#F8D03F]" : "text-white"}
      >Projects</a
    >
  </div>
  <a
    href="https://ucfai.org/linktree"
    target="_blank"
    rel="noopener noreferrer"
  >
    <div
      class="no-particles p-1.5 w-10 h-10 flex justify-center items-center bg-white rounded-2xl"
    >
      <Icon name="fa7-brands:linktree" class="w-6.5 h-6.5 text-black my-auto" />
    </div>
  </a>
</nav>
